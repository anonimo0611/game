{
	"compilerOptions": {
		"paths": {
			"@lib/*": ["./_lib/*"],
			"@snd/*": ["./_snd/*"],
			"@src/*": ["./src/*"],
			"@actors": ["./src/actors.js"],
		},
		"module": "es2022",
		"target": "esnext",
		"checkJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
	}
}